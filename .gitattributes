# Les fichiers lus tels quels par Aria (config Unbound, clé racine DNSSEC) gardent
# des fins de ligne LF, même dans un clone Windows.
*.tmpl text eol=lf
*.key  text eol=lf

# Binaires embarqués : jamais de conversion
*.gpg binary
*.gz  binary
*.dll binary
*.ico binary
*.png binary

# Scripts PowerShell : UTF-8 avec BOM et fins de ligne CRLF (Windows PowerShell 5.1 en a besoin)
*.ps1 text eol=crlf
